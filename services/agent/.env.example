AGENT_ENVIRONMENT=development
AGENT_LOG_LEVEL=INFO
AGENT_PORT=8000
AGENT_LLM_PROVIDER=openai
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=gpt-4o
AGENT_LLM_TIMEOUT_SECONDS=20
AGENT_LLM_MAX_IMAGE_BYTES=10485760
AGENT_GEOCODE_PROVIDER=nominatim
AGENT_GEOCODE_USER_AGENT=CivicFix/0.1 (contact@example.com)
AGENT_GEOCODE_TIMEOUT_SECONDS=10
AGENT_GEOCODE_RATE_LIMIT_SECONDS=1
AGENT_GEOCODE_CACHE_PRECISION=4
AGENT_VECTOR_STORE=chroma
AGENT_VECTOR_STORE_PATH=.civicfix/chroma
AGENT_VECTOR_COLLECTION=municipalities
AGENT_RUN_SECRET=
AGENT_CHECKPOINT_DB=.civicfix/runs.sqlite
# Set AGENT_VECTOR_STORE=pinecone and provide these variables for a hosted store.
# PINECONE_API_KEY=
# PINECONE_INDEX=civicfix-municipalities