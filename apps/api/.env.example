NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/civicfix
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
AGENT_SHARED_SECRET=replace-with-the-agent-service-secret
EMAIL_MODE=dry-run
EMAIL_FROM=noreply@civicfix.local
EMAIL_REPLY_TO_DOMAIN=reply.civicfix.local
INBOUND_EMAIL_WEBHOOK_SECRET=replace-with-inbound-email-webhook-secret
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
SENDGRID_API_KEY=
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_BASE_DELAY_MS=250
EMAIL_ATTACH_PHOTO=false